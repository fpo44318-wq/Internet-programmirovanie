{% extends "__layout.twig" %}

{% block content %}

<h1>{{ object.title }}</h1>

<ul class="nav nav-pills list-group list-group-horizontal mb-4">
    <li class="nav-item me-2">
        <a class="nav-link {{ is_image ? 'active' : '' }}" href="/{{ url_title }}/image">
            Картинка
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link {{ is_info ? 'active' : '' }}" href="/{{ url_title }}/info">
            Описание
        </a>
    </li>
</ul>

<div class="mt-3">
    {% if is_image %}
        <div style="display: flex; gap: 30px; align-items: flex-start;">
            <img src="{{ object.image }}" alt="{{ object.title }}" style="width: 400px; max-width: 100%; object-fit: cover;">
            <div style="flex: 1;">
                <p>{{ object.description }}</p>
            </div>
        </div>
    {% elseif is_info %}
        <p>{{ object.info }}</p>
    {% endif %}
</div>

<a href="/cards" class="btn btn-outline-secondary mt-3">Вернуться к карточкам</a>

{% endblock %}