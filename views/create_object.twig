{% extends "__layout.twig" %}

{% block content %}
<h1>Добавить новую карточку</h1>

{% if success_message %}
    <div class="alert alert-success">{{ success_message }}</div>
{% endif %}

{% if form_errors %}
    <div class="alert alert-danger">
        {% for error in form_errors %}
            <div>{{ error }}</div>
        {% endfor %}
    </div>
{% endif %}

<form method="POST" action="/create">
    <div class="mb-3">
        <label for="title" class="form-label">Название</label>
        <input type="text" class="form-control" id="title" name="title" 
               value="{{ old_data.title }}" required>
    </div>
    
    <div class="mb-3">
        <label for="description" class="form-label">Описание</label>
        <textarea class="form-control" id="description" name="description" 
                  rows="5" required>{{ old_data.description }}</textarea>
    </div>
    
    <div class="mb-3">
        <label for="image" class="form-label">URL картинки</label>
        <input type="url" class="form-control" id="image" name="image" 
               value="{{ old_data.image }}" required>
    </div>
    
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a href="/cards" class="btn btn-secondary">Отмена</a>
</form>
{% endblock %}