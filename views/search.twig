{% extends "__layout.twig" %}

{% block content %}
    <h1>Поиск изобретателей</h1>
    
    <form method="get" action="/search" class="mb-4">
        <div class="row g-3">
            <div class="col-md-8">
                <input type="text" name="search" class="form-control form-control-lg" 
                       placeholder="Введите название..." value="{{ search }}">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary btn-lg w-100">Найти</button>
            </div>
        </div>
    </form>
    
    <hr>
    
    {% if search is not empty %}
        <h3>Результаты поиска по запросу "{{ search }}":</h3>
        
        {% if objects is not empty %}
            <section class="section-top-selling">
                <div class="container">
                    <div class="d-flex flex-column">
                        <div class="row">
                            {% for object in objects %}
                                <div class="col-3">
                                    <div class="top-selling-item">
                                        <img src="{{ object.image }}" alt="{{ object.title }}" class="card-img-top">
                                        <div class="top-selling-item-info">
                                            <div class="d-flex top-selling-item-description justify-content-between">
                                                <div class="top-selling-item__title">{{ object.title }}</div>
                                                <div class="top-selling-item__price"></div>
                                            </div>
                                            <div class="top-selling-item__Length d-flex gap-2">
                                               
                                                <a href="/space-object/{{ object.id }}/info" class="btn btn-primary btn-sm">Описание</a>
                                                <a href="/space-object/{{ object.id }}/image" class="btn btn-secondary btn-sm">Картинка</a>
                                                {% if session.role == 'admin' %}
                                                    <a href="/delete/{{ object.id }}" class="btn btn-danger btn-sm" onclick="return confirm('Удалить карточку?')">Удалить</a>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Каждые 4 карточки закрываем row и открываем новую -->
                                {% if loop.index % 4 == 0 and not loop.last %}
                                    </div><div class="row mt-4">
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </section>
        {% else %}
            <div class="alert alert-warning">Ничего не найдено</div>
        {% endif %}
    {% endif %}
{% endblock %}